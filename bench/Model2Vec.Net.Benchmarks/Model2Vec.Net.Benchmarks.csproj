<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <AssemblyName>Model2Vec.Net.Benchmarks</AssemblyName>
    <RootNamespace>Model2VecNet.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Model2Vec.Net\Model2Vec.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="models\potion-base-2M\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('models\potion-base-2M')" />
  </ItemGroup>

</Project>
