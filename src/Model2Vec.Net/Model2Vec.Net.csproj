<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Model2VecNet</RootNamespace>
    <AssemblyName>Model2Vec.Net</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <PackageId>Model2Vec.Net</PackageId>
    <Version>0.1.0</Version>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Authors>ericstj</Authors>
    <Description>Pure-managed Model2Vec static embedding inference for .NET. Loads safetensors embeddings and Hugging Face tokenizers without native dependencies.</Description>
    <PackageTags>model2vec;embeddings;static-embeddings;nlp;machine-learning;safetensors</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ericstj/Model2Vec.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericstj/Model2Vec.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>

</Project>
